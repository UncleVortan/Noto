{
  "manifest_version": 3,
  "name": "Noto",
  "version": "1.0.0",
  "description": "Noto — AI-powered study assistant. Flashcards, quizzes, notes & focus timer.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://api.groq.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://api.cohere.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Noto"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "noto@extension",
      "strict_min_version": "109.0"
    }
  }
}
